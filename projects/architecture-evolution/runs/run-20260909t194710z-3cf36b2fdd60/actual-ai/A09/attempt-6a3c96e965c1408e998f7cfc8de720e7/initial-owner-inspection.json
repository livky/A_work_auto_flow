    "records": {
      "MEM-2810407a-91e3-5114-b909-9a737b5e7885": {
        "body_markdown": "",
        "change_reason": "独立合成前提输入；用于实际 AI 使用检查，非实际试验或科学复核",
        "content_hash": "4f786f9e28baf3ef293c833a34d2b666609bc63df05d2819dbaa706f2c44ae35",
        "created_at": "2026-09-09T21:02:10.226996Z",
        "created_by": {
