      "MEM-d8f598be-5b56-539f-ab3e-c53cfbb8d17a": {
        "body_markdown": "",
        "change_reason": "独立合成前提输入；用于实际 AI 使用检查，非实际试验或科学复核",
        "content_hash": "cd5734f455619944ab212df1481de905501591758e356a19df38c11a1fcca75f",
